{
  "name": "booki-dock",
  "private": true,
  "version": "0.70.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "description": "Booki — a smart dock for Windows",
  "license": "MIT",
  "homepage": "https://github.com/punkable/booki#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/punkable/booki.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check:text": "node scripts/check-text-encoding.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:node": "node scripts/check-node.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test:validation": "node --test scripts/validation.test.mjs",
    "check:all": "npm run check:node && npm run check:versions && npm run lint && npm run typecheck && npm run check:text && npm run check:icons && npm run check:i18n && npm run test:validation && npm run build && npm test",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/api": "~2.12.1",
    "@tauri-apps/plugin-dialog": "~2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
